WORKSPACE_ROOT=${${(%):-%x}:A:h}

# Send the repo hook over SSH, install it remotely, and prepare each session.
tmux_prepare_remote() {
  local host=$1 target_dir=$2 status_style=$3 remote_group=$4 title_prefix=$5
  shift 5
  if (( $# % 2 )); then
    print -u2 -- 'tmux_prepare_remote requires session and title label pairs'
    return 1
  fi
  local remote_command="sh -s -- ${(qq)target_dir} ${(qq)status_style} ${(qq)remote_group} ${(qq)title_prefix}"
  local session_name title_label
  while (( $# )); do
    session_name=$1 title_label=$2
    shift 2
    remote_command+=" ${(qq)session_name} ${(qq)title_label}"
  done
  [[ -r "$WORKSPACE_ROOT/.tmux_session.shared.sh" ]] || return 1

  # Stream a shell script over SSH; its heredoc contains the local hook file.
  {
    print -r -- 'set -eu'
    print -r -- 'umask 077'
    print -r -- 'hook_tmp=$(mktemp "$HOME/.tmux_session.shared.sh.XXXXXX")'
    print -r -- 'trap '\''rm -f -- "$hook_tmp"'\'' 0'
    print -r -- 'cat > "$hook_tmp" <<'\''TMUX_SESSION_HOOK_EOF'\'''
    cat -- "$WORKSPACE_ROOT/.tmux_session.shared.sh"
    print -r -- 'TMUX_SESSION_HOOK_EOF'
    print -r -- 'mv -- "$hook_tmp" "$HOME/.tmux_session.shared.sh"'
    print -r -- '. "$HOME/.tmux_session.shared.sh"'
    print -r -- 'tmux_session_install'
    print -r -- 'target_dir=$1; status_style=$2; remote_group=$3; title_prefix=$4; shift 4'
    print -r -- 'while [ "$#" -gt 0 ]; do'
    print -r -- '  session_name=$1; title_label=$2; shift 2'
    print -r -- '  session_id=$(tmux_session_prepare "$target_dir" "$session_name" "$status_style") || exit'
    print -r -- '  if [ -n "$remote_group" ]; then'
    print -r -- '    tmux set-option -t "$session_id" @workspace_remote_group "$remote_group" || exit'
    print -r -- '    tmux set-option -t "$session_id" @workspace_remote_name "$session_name" || exit'
    print -r -- '  fi'
    print -r -- '  tmux_session_set_title "$session_id" "$title_prefix" "$title_label" || exit'
    print -r -- 'done'
  } | ssh "$host" "$remote_command"
}

# Attach to an existing remote session, or create one if it is missing.
# Optional title prefix/label reapply the managed title when a prepared
# session disappears before this call.
tmux_connect() {
  if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: connect <host> <session[:tab]> [title-prefix title-label]"
    return 1
  fi
  local host=$1 session=$2 title_prefix=${3:-} title_label=${4:-}
  local q_session=${(qq)session} q_prefix=${(qq)title_prefix} q_label=${(qq)title_label}
  local remote_command='if [ -r "$HOME/.tmux_session.shared.sh" ]; then
  . "$HOME/.tmux_session.shared.sh"
  session_id=$(tmux_session_id '
  remote_command+=$q_session
  remote_command+=')
  if [ -z "$session_id" ]; then
    session_id=$(tmux new-session -d -P -F "#{session_id}" -s '
  remote_command+=$q_session
  remote_command+=') || exit
    if [ -n '
  remote_command+=$q_prefix
  remote_command+=' ]; then
      tmux_session_set_title "$session_id" '
  remote_command+="$q_prefix $q_label"
  remote_command+=' || exit
    fi
  fi
  exec tmux attach-session -t "$session_id"
fi
exec tmux new-session -A -s '
  remote_command+=$q_session
  ssh -t "$host" "$remote_command"
}
